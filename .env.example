# Memory Card — configuração
#
# Copie este arquivo para `.env` e preencha os OBRIGATÓRIOS.
# O `.env` nunca entra no controle de versão.
#
# Os 8 parâmetros obrigatórios estão marcados com [OBRIGATÓRIO].
# Todos os demais têm padrão e podem ficar em branco.
# A ausência de qualquer obrigatório impede a inicialização, com erro
# nomeando o parâmetro faltante. Nunca há modo permissivo por omissão.


# ---------------------------------------------------------------------------
# Captura (Telegram)
# ---------------------------------------------------------------------------

# [OBRIGATÓRIO] Token do bot, obtido com o BotFather no Telegram.
# Um token vazado permite a terceiros assumir o bot.
TELEGRAM_BOT_TOKEN=

# [OBRIGATÓRIO] Identificador numérico do ÚNICO usuário aceito.
# Mensagem de qualquer outro remetente é descartada antes de qualquer
# processamento, sem resposta. Sem este valor o sistema NÃO inicia.
TELEGRAM_USUARIO_AUTORIZADO=

# Pasta local onde os áudios originais são preservados após o processamento.
CAPTURA_PASTA_AUDIO=./dados/audios

# Arquivo que persiste o deslocamento de leitura do long polling.
# É ele que garante o processamento exatamente-uma-vez após reinício.
CAPTURA_ESTADO_POLLING=./dados/estado_polling.json

# Tentativas e tempo limite do download de áudio.
CAPTURA_TENTATIVAS_DOWNLOAD=3
CAPTURA_TIMEOUT_DOWNLOAD_S=30


# ---------------------------------------------------------------------------
# Transcrição (Whisper local)
# ---------------------------------------------------------------------------
# Nenhum parâmetro obrigatório: com tudo em branco, a transcrição funciona
# nos padrões. É o único componente que não depende de serviço externo.

# Modelo de transcrição. Principal alavanca entre qualidade e tempo.
# O ponto ótimo só é conhecido por medição na sua máquina.
WHISPER_MODELO=small

# Idioma esperado. É uma DICA, não uma restrição: a detecção automática
# continua ativa, para não rejeitar trechos em outro idioma.
WHISPER_IDIOMA=pt

# Dispositivo de execução: cpu ou cuda.
WHISPER_DISPOSITIVO=cpu

# Tempo limite de uma única transcrição de áudio CURTO, em segundos.
WHISPER_TIMEOUT_S=300

# Pasta onde o modelo é armazenado após a obtenção inicial.
WHISPER_PASTA_MODELOS=./dados/modelos

# Duração, em segundos, a partir da qual o áudio é tratado como LONGO
# (reunião): tempo limite próprio, aviso de processamento estendido e
# classificação em duas passagens.
AUDIO_LONGO_LIMITE_S=180

# Tempo limite de transcrição para áudio longo, em segundos.
WHISPER_TIMEOUT_LONGO_S=3600


# ---------------------------------------------------------------------------
# Classificação (modelo de linguagem via API)
# ---------------------------------------------------------------------------

# [OBRIGATÓRIO] Chave de acesso à API do provedor.
# Uma chave vazada gera custo financeiro direto. Nunca aparece em log.
LLM_API_KEY=

# [OBRIGATÓRIO] Provedor. Lido pela fronteira única para escolher o adaptador.
LLM_PROVEDOR=

# [OBRIGATÓRIO] Identificador do modelo dentro do provedor.
LLM_MODELO=

# Endereço base da API. Em branco usa o padrão do provedor.
LLM_ENDPOINT=

# Tempo limite de uma chamada e número máximo de tentativas.
LLM_TIMEOUT_S=15
LLM_TENTATIVAS=3

# Arquivo com o texto do prompt. Editável sem tocar em código: é a
# principal alavanca de melhoria da qualidade da classificação.
LLM_PROMPT_ARQUIVO=./config/prompt_classificacao.txt

# Conjunto FECHADO de tipos aceitos. Tipo fora desta lista invalida a
# resposta do modelo. Alterar a lista não invalida registros já gravados.
LLM_TIPOS_REGISTRO=ideia,insight,tarefa,referencia,duvida


# ---------------------------------------------------------------------------
# Acervo
# ---------------------------------------------------------------------------

# Pasta raiz do acervo. É o parâmetro mais consequente do sistema.
# ATENÇÃO: alterá-lo depois de haver conteúdo NÃO move os arquivos
# existentes. O sistema passa a escrever no caminho novo e o acervo antigo
# fica órfão, invisível ao painel e ao digest. Mover exige ação manual.
ACERVO_PASTA=./dados/acervo

# Granularidade das pastas derivadas da data de captura: mensal ou semanal.
# Afeta apenas registros novos.
ACERVO_GRANULARIDADE_PASTA=mensal

# Índice auxiliar. Pode ser apagado a qualquer momento e é reconstruído
# integralmente a partir dos arquivos markdown.
ACERVO_INDICE_ARQUIVO=./dados/indice.json

# Em branco, registros descartados permanecem onde estão e apenas mudam
# de estado. Preenchido, são movidos para a pasta indicada.
ACERVO_PASTA_DESCARTADOS=

# Máximo de caracteres do nome de arquivo derivado do assunto.
# O assunto completo permanece íntegro nos metadados.
ACERVO_TAMANHO_MAX_NOME=80


# ---------------------------------------------------------------------------
# Digest semanal (e-mail)
# ---------------------------------------------------------------------------

# [OBRIGATÓRIO] Endereço que recebe o digest. Destinatário ÚNICO,
# não há suporte a lista.
DIGEST_EMAIL_DESTINO=

# [OBRIGATÓRIO] Endereço exibido como remetente.
DIGEST_EMAIL_REMETENTE=

# [OBRIGATÓRIO] Servidor de e-mail de saída.
SMTP_SERVIDOR=
SMTP_PORTA=587

# Credenciais. NÃO são obrigatórias na inicialização — um relay local sem
# autenticação é caso legítimo. Mas para Gmail/Outlook são indispensáveis, e
# em branco o sistema sobe normalmente: a falha aparece só no envio do digest.
# Use senha de aplicativo específica, NUNCA a senha principal da conta.
SMTP_USUARIO=
SMTP_SENHA=

# Dia e horário do envio semanal. Padrões: sexta, 19:00.
#
# O envio não é reposto na semana seguinte: a janela de recuperação vai do
# horário marcado até a virada da semana ISO, na meia-noite de domingo. Quanto
# mais cedo na semana, mais folga para a máquina estar ligada em algum momento.
DIGEST_DIA_SEMANA=sexta
DIGEST_HORARIO=19:00

# Máximo de registros por envio.
DIGEST_QUANTIDADE=5

# Endereço base do painel, usado para montar os links de marcação.
# PRECISA ser coerente com PAINEL_INTERFACE e PAINEL_PORTA, senão o
# digest chega íntegro com todos os links apontando para lugar nenhum.
PAINEL_URL_BASE=http://localhost:8000


# ---------------------------------------------------------------------------
# Painel de acompanhamento
# ---------------------------------------------------------------------------

# Porta e interface de escuta. A interface é RESTRITA a loopback:
# qualquer outro valor impede a inicialização. O acervo é o dado mais
# sensível do sistema e a proteção vem de não estar exposto, não de senha.
PAINEL_PORTA=8000
PAINEL_INTERFACE=127.0.0.1

# Período exibido ao abrir o painel: mes-corrente ou ultimos-30-dias.
PAINEL_PERIODO_PADRAO=mes-corrente

# Exibir registros descartados na listagem por padrão.
PAINEL_EXIBIR_DESCARTADOS=false

# Registros por página. Não afeta as contagens totais.
PAINEL_ITENS_POR_PAGINA=50


# ---------------------------------------------------------------------------
# Operação
# ---------------------------------------------------------------------------

# Pasta da fila de processamento persistida em disco.
FILA_PASTA=./dados/fila

# Nível de log: DEBUG, INFO, WARNING, ERROR.
LOG_NIVEL=INFO
